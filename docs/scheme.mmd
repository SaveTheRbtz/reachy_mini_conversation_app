---
config:
  layout: dagre
  flowchart:
    htmlLabels: true
---
flowchart TB
    User(["<span style='font-size:16px;font-weight:bold;'>User</span><br><span style='font-size:13px;color:#01579b;'>Voice and presence</span>"])
    Robot@{ label: "<span style='font-size:16px;font-weight:bold;'>Reachy Mini SDK</span><br><span style='font-size:13px;color:#c62828;'>Microphone, speaker, camera, motion</span>" }
    App@{ label: "<span style='font-size:16px;font-weight:bold;'>Conversation App</span><br><span style='font-size:12px;color:#0277bd;'>One session owner + audio bridge</span>" }
    Live@{ label: "<span style='font-size:16px;font-weight:bold;'>OpenAI Live</span><br><span style='font-size:12px;color:#7b1fa2;'>gpt-live-1 continuous voice</span>" }
    Backend@{ label: "<span style='font-size:16px;font-weight:bold;'>Responses Backend</span><br><span style='font-size:12px;color:#7b1fa2;'>gpt-6-astra, low reasoning</span>" }
    Tools@{ label: "<span style='font-size:16px;font-weight:bold;'>Typed Tool Layer</span><br><span style='font-size:12px;color:#f9a825;'>Robot functions + memory persistence</span>" }
    Vision@{ label: "<span style='font-size:16px;font-weight:bold;'>Camera Vision</span><br><span style='font-size:12px;color:#7b1fa2;'>gpt-6-astra, low reasoning, store=False</span>" }
    Search@{ label: "<span style='font-size:16px;font-weight:bold;'>OpenAI Web Search</span><br><span style='font-size:12px;color:#7b1fa2;'>Hosted by the Responses backend</span>" }
    Profiles@{ label: "<span style='font-size:16px;font-weight:bold;'>Profile State</span><br><span style='font-size:12px;color:#6a1b9a;'>Personality prompt + enabled tools</span>" }
    Context@{ label: "<span style='font-size:16px;font-weight:bold;'>Typed Run Context</span><br><span style='font-size:12px;color:#6a1b9a;'>ToolDependencies + MemorySnapshot</span>" }
    Memory@{ label: "<span style='font-size:16px;font-weight:bold;'>Shared Household Memory</span><br><span style='font-size:12px;color:#6a1b9a;'>Atomic memory.json</span>" }
    UI@{ label: "<span style='font-size:16px;font-weight:bold;'>Optional Web UI</span><br><span style='font-size:12px;color:#0277bd;'>Settings and session status</span>" }

    User <--> Robot
    Robot <-- audio --> App
    App <-- audio and session events --> Live
    Live <-- delegation --> Backend
    Backend -- function calls --> Tools
    Tools -- concise results --> Backend
    Tools -- question + JPEG --> Vision
    Vision -- visual description --> Tools
    Backend <--> Search
    Profiles --> App
    App -- owns --> Context
    Profiles -- voice instructions --> Live
    Context -- reasoning instructions --> Backend
    Tools <-- typed reads and mutations --> Context
    Memory <-- load and atomic persistence --> Context
    Tools --> Robot
    Robot -- camera frame --> Tools
    UI --> App

    User:::userStyle
    UI:::uiStyle
    App:::uiStyle
    Live:::aiStyle
    Backend:::aiStyle
    Vision:::aiStyle
    Search:::aiStyle
    Robot:::hardwareStyle
    Profiles:::toolStyle
    Context:::toolStyle
    Memory:::toolStyle
    Tools:::toolStyle
    classDef userStyle fill:#e1f5fe,stroke:#01579b,stroke-width:3px
    classDef uiStyle fill:#b3e5fc,stroke:#0277bd,stroke-width:2px
    classDef aiStyle fill:#e1bee7,stroke:#7b1fa2,stroke-width:3px
    classDef hardwareStyle fill:#ef9a9a,stroke:#c62828,stroke-width:3px
    classDef toolStyle fill:#fffde7,stroke:#f9a825,stroke-width:1px
