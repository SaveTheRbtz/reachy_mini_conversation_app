# Required for the OpenAI Realtime session.
OPENAI_API_KEY=

# Optional bundled profile selector. The default profile is used when unset.
# REACHY_MINI_CUSTOM_PROFILE=mars_rover

# Minutes of inactivity before Reachy sleeps and the app stops. Defaults to 1440; 0 disables it.
# REACHY_MINI_APP_TIMEOUT_MINUTES=1440
