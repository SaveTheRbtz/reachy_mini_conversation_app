# Required for the OpenAI Live session.
OPENAI_API_KEY=

# Optional bundled profile selector. The default profile is used when unset.
# REACHY_MINI_CUSTOM_PROFILE=mars_rover

# Default Live voice when no profile or saved UI choice overrides it.
# OPENAI_VOICE=gleam

# Minutes of inactivity before Reachy sleeps and the app stops. Defaults to 15; 0 disables it.
# REACHY_MINI_APP_TIMEOUT_MINUTES=15
